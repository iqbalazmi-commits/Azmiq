# ---------------------------------------------------------------------------
# AZMIQ STORE - environment
# Copy to .env.local. Never commit .env.local.
# ---------------------------------------------------------------------------

# Public origin, used for canonical URLs, sitemap, JSON-LD and Stripe returns.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Leave EMPTY to use the embedded PGlite dev database in ./.pgdata.
DATABASE_URL=

# Stripe. Card fields are hosted by Stripe (Payment Element) - card data never
# reaches this server, so this app is PCI-DSS SAQ A scope.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# Transactional email (order confirmations, magic links, RMA notices).
RESEND_API_KEY=
EMAIL_FROM="AZMIQ <shop@azmiq.com>"
# Inbox for "new order" owner alerts. Blank = fall back to ADMIN_EMAIL.
ORDER_ALERT_EMAIL=

# Alternatives to Resend, in the order they are tried. Resend wins whenever
# RESEND_API_KEY is set; otherwise SMTP; otherwise Gmail.

# Any ordinary mailbox, including the one on your own domain - the way to send
# as shop@azmiq.com without signing up to a provider. Your mail host documents
# these under "SMTP settings". Port 465 is implicit TLS, 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Gmail specifically. No signup, but Google caps it near 500 messages a day and
# deliverability is weaker than a real transactional provider.
# GMAIL_APP_PASSWORD must be a 16-character App Password
# (myaccount.google.com/apppasswords), never the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Pay by bank transfer. Free to accept - no processor takes a cut - but each
# one is confirmed by hand in the admin once the money appears in the account.
# All three of NAME/SORT_CODE/ACCOUNT_NUMBER are required to offer it; leave any
# blank and the option is hidden at checkout. IBAN/BIC are for overseas buyers.
BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
BANK_NAME=
BANK_IBAN=
BANK_BIC=

# Klaviyo - marketing only. Server-side events survive a cookie-consent
# decline, which is the whole reason they are sent from the server.
KLAVIYO_PRIVATE_API_KEY=
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=

# GA4 Measurement Protocol (server-side purchase event).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=


# First admin user, created by `npm run db:seed`.
ADMIN_EMAIL=owner@azmiq.com
ADMIN_PASSWORD=change-me-before-launch
# Klaviyo list for the footer newsletter form.
KLAVIYO_LIST_ID=

# Shared secret Vercel Cron sends to /api/cron/* as a Bearer token. The basket
# reminder job refuses to run without it. Generate any long random string.
CRON_SECRET=

# Google Search Console verification token (the content= value of the
# meta tag it gives you). Blank renders no tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Meta (Facebook/Instagram) advertising. The pixel is the browser side and
# only loads with marketing consent; the Conversions API token lets the server
# report purchases too, which survives ad blockers and iOS tracking limits.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# Google Ads conversion tracking. The ID looks like AW-123456789. The label is
# the second half of the conversion action, like AbC-D_efGh1234.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
