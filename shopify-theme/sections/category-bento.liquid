{%- comment -%}
  "Shop by category": a bento grid of collection tiles. The first tile is
  large; each shows the collection image, or its first product's photo.
{%- endcomment -%}
<section class="container section">
  <div class="section-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <hr class="rule">
      <h2 class="heading-lg">{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link_url | default: routes.all_products_collection_url }}" class="link-arrow">{{ section.settings.link_label }}{% render 'icon', name: 'arrow-right', size: 15 %}</a>
    {%- endif -%}
  </div>

  <div class="bento">
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.collection
        assign img = block.settings.image
        if img == blank and c != blank
          assign img = c.image
          if img == blank
            assign img = c.products.first.featured_media
          endif
        endif
        assign label = block.settings.label | default: c.title
      -%}
      <a href="{{ c.url | default: '#' }}" class="bento__tile" {{ block.shopify_attributes }}>
        {%- if img -%}
          {{ img | image_url: width: 1400 | image_tag: sizes: '(min-width: 1024px) 40vw, (min-width: 768px) 50vw, 100vw', widths: '500, 800, 1100, 1400', loading: 'lazy', alt: '' }}
        {%- endif -%}
        <div class="bento__body">
          <span class="bento__hairline" aria-hidden="true"></span>
          {%- if block.settings.blurb != blank -%}<p class="bento__blurb">{{ block.settings.blurb }}</p>{%- endif -%}
          <h3 class="bento__title">{{ label }}{% render 'icon', name: 'arrow-right', size: 18 %}</h3>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category grid",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label (defaults to collection name)" },
        { "type": "text", "id": "blurb", "label": "Small line above the label" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "tile", "settings": { "label": "Leather", "blurb": "Jackets and a leather trench" } },
        { "type": "tile", "settings": { "label": "Copperware", "blurb": "Pure copper, hand-hammered" } },
        { "type": "tile", "settings": { "label": "Kitchen", "blurb": "Sustainable acacia wood" } },
        { "type": "tile", "settings": { "label": "Gifts", "blurb": "Matched sets, ready to give" } }
      ]
    }
  ]
}
{% endschema %}
