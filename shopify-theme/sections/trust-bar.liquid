<section class="trust-bar" aria-label="Shopping reassurance">
  <ul class="container">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon, size: 16 %}{{ block.settings.text }}</li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Reassurance strip",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "package-check",
          "options": [
            { "value": "package-check", "label": "Parcel" },
            { "value": "rotate-ccw", "label": "Returns" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "globe", "label": "Globe" },
            { "value": "leaf", "label": "Leaf" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Tracked worldwide shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reassurance strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "package-check", "text": "Tracked worldwide shipping" } },
        { "type": "item", "settings": { "icon": "rotate-ccw", "text": "14-day returns" } },
        { "type": "item", "settings": { "icon": "shield-check", "text": "Free UK delivery over £50" } }
      ]
    }
  ]
}
{% endschema %}
