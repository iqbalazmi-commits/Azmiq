{%- comment -%}
  Reviews band. Shopify has no built-in reviews, so install a review app
  (e.g. Judge.me) and add its block here in the theme editor.
{%- endcomment -%}
<section id="reviews" class="section section--bordered">
  <div class="container">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="heading-lg" style="margin-top:.75rem">{{ section.settings.heading }}</h2>
    <hr class="rule" style="margin-block:2rem">
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
    {%- else -%}
      <p class="small muted">No reviews yet — be the first.</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What customers say" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
