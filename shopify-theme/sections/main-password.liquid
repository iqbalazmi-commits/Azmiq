<div class="narrow">
  <div style="display:flex;justify-content:center">{% render 'logo', size: 64 %}</div>
  <h1 style="margin-top:2rem">{{ section.settings.heading }}</h1>
  <hr class="rule">
  {%- if shop.password_message != blank -%}<p class="muted" style="text-align:center;margin-top:1.5rem">{{ shop.password_message }}</p>{%- endif -%}

  {%- form 'customer' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success">Thank you — we'll let you know when we open.</p>
    {%- else -%}
      <div class="field">
        <label for="PasswordEmail">Email me when the shop opens</label>
        <input class="input" type="email" id="PasswordEmail" name="contact[email]" autocomplete="email" required>
      </div>
      <button class="button" type="submit">Notify me</button>
    {%- endif -%}
  {%- endform -%}

  <details style="margin-top:2.5rem">
    <summary class="small muted" style="cursor:pointer;text-align:center">Enter with password</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field">
        <label for="StorePassword">Password</label>
        <input class="input" type="password" id="StorePassword" name="password" autocomplete="current-password" required>
      </div>
      <button class="button button--secondary" type="submit">Enter</button>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }]
}
{% endschema %}
