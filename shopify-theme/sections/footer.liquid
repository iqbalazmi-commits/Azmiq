<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        {% render 'logo', size: 50, tagline: true %}
        <hr class="rule">
        {%- if section.settings.about != blank -%}
          <p class="site-footer__about">{{ section.settings.about }}</p>
        {%- endif -%}

        <ul class="site-footer__contact">
          {%- if settings.contact_email != blank -%}
            <li><a href="mailto:{{ settings.contact_email }}">{% render 'icon', name: 'mail', size: 15 %}{{ settings.contact_email }}</a></li>
          {%- endif -%}
          {%- if settings.contact_phone != blank -%}
            <li><a href="tel:{{ settings.contact_phone | remove: ' ' }}">{% render 'icon', name: 'phone', size: 15 %}{{ settings.contact_phone }}</a></li>
          {%- endif -%}
        </ul>

        <div class="socials">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="me noopener noreferrer" aria-label="{{ shop.name }} on Instagram">{% render 'icon', name: 'instagram', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="me noopener noreferrer" aria-label="{{ shop.name }} on Facebook">{% render 'icon', name: 'facebook', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="me noopener noreferrer" aria-label="{{ shop.name }} on TikTok">{% render 'icon', name: 'tiktok', size: 18 %}</a>
          {%- endif -%}
        </div>

        {%- if section.settings.show_newsletter -%}
          <div class="newsletter">
            <h2 class="eyebrow">{{ section.settings.newsletter_heading }}</h2>
            {%- form 'customer', id: 'FooterNewsletter' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="form-message form-message--success" role="status">Thank you — you're on the list.</p>
              {%- else -%}
                <div class="newsletter__row">
                  <label class="visually-hidden" for="NewsletterEmail">Email address</label>
                  <input class="input" id="NewsletterEmail" type="email" name="contact[email]" placeholder="you@example.com" autocomplete="email" required>
                  <button class="button" type="submit">Subscribe</button>
                </div>
                {%- if form.errors -%}
                  <p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      <div class="site-footer__cols">
        {%- for block in section.blocks -%}
          <nav aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            <h2 class="eyebrow">{{ block.settings.heading }}</h2>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endfor -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.{% if section.settings.legal_line != blank %} {{ section.settings.legal_line }}{% endif %}</p>
      {%- if section.settings.show_payment_icons -%}
        <ul class="payment-icons" aria-label="Payment methods we accept">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "textarea",
      "id": "about",
      "label": "About text",
      "default": "Leather, pure copper drinkware and home essentials — made by artisans who have worked their material for generations. Priced fairly and openly."
    },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter sign-up", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Slow letters, not spam" },
    { "type": "text", "id": "legal_line", "label": "Legal line", "default": "Registered in England & Wales." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
