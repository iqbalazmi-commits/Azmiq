<div class="container page-head" style="padding-bottom:7rem">
  {% render 'breadcrumbs', current: blog.title %}
  <h1 class="heading-xl">{{ blog.title }}</h1>
  <hr class="rule">
  {%- paginate blog.articles by 9 -%}
    <div class="product-grid product-grid--3" style="margin-top:3rem">
      {%- for article in blog.articles -%}
        <article class="card">
          <div class="card__media">
            {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: class: 'card__main', loading: 'lazy', sizes: '(min-width: 1280px) 26vw, 45vw', widths: '300, 600, 900' }}{%- endif -%}
          </div>
          <div class="card__body">
            <p class="eyebrow">{{ article.published_at | date: '%-d %B %Y' }}</p>
            <h2 class="card__title" style="margin-top:.5rem"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="card__subtitle">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
