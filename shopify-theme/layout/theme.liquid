<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <meta name="theme-color" content="#FFFFFF">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'azmiq-logo.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {% render 'meta-tags' %}

    {%- liquid
      assign heading_font = settings.type_heading_font
      assign body_font = settings.type_body_font
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
      assign body_font_semibold = body_font | font_modify: 'weight', '600'
      assign body_font_medium = body_font | font_modify: 'weight', '500'
    -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    <style>
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_medium | font_face: font_display: 'swap' }}
      {{ body_font_semibold | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      :root {
        --font-heading-family: {{ heading_font.family }}, "Iowan Old Style", Georgia, serif;
        --font-body-family: {{ body_font.family }}, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --color-accent: {{ settings.color_accent }};
        --color-gold: {{ settings.color_gold }};
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>
      window.routes = { cart: {{ routes.cart_url | json }}, root: {{ routes.root_url | json }} };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'organization-schema' %}
  </body>
</html>
