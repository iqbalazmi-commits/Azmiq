<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <title>{{ shop.name }}</title>
    {%- liquid
      assign heading_font = settings.type_heading_font
      assign body_font = settings.type_body_font
    -%}
    <style>
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      :root {
        --font-heading-family: {{ heading_font.family }}, Georgia, serif;
        --font-body-family: {{ body_font.family }}, system-ui, sans-serif;
        --color-accent: {{ settings.color_accent }};
        --color-gold: {{ settings.color_gold }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
